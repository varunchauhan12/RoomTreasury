# Names and placeholders only. Replace placeholders in a private environment.
# Modes: test, demo, real. No mode or database path fallback outside tests.
# demo path must be within <project>/var/demo/; real within <project>/var/real/.
# test path must be in an OS temp directory named roomtreasury-test-*.
ROOMTREASURY_MODE=<test|demo|real>
ROOMTREASURY_DB_PATH=<explicit-database-file-path>
ROOMTREASURY_HOST=<127.0.0.1|::1>
ROOMTREASURY_PORT=<port-number>
# No credentials are required or supported by this foundation.
